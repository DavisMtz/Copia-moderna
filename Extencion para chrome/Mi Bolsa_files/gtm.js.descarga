se,"vtp_enableEditJsMacroBehavior":false,"tag_id":2886},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":"\u003Cscript type=\"text\/gtmscript\"\u003Efunction setCookie(c,d,a){var b=new Date;b.setTime(b.getTime()+a*6E4);a=\"expires\\x3d\"+b.toUTCString();document.cookie=c+\"\\x3d\"+d+\";\"+a+\";path\\x3d\/;Domain\\x3dwww.liverpool.com.mx;\"}function setCookieNo(c,d,a){var b=new Date;b.setTime(b.getTime()+a*6E4);a=\"expires\\x3d\"+b.toUTCString();document.cookie=c+\"\\x3d\"+d+\";\"+a+\";path\\x3d\/;Domain\\x3dliverpool.com.mx;\"}\nfunction setCookieSi(c,d,a){var b=new Date;b.setTime(b.getTime()+a*6E4);a=\"expires\\x3d\"+b.toUTCString();document.cookie=c+\"\\x3d\"+d+\";\"+a+\";path\\x3d\/\"}setCookie(\"_abck\\x3d\",\"\",0);setCookieSi(\"_abck\\x3d\",\"\",0);setCookieNo(\"_abck\\x3d\",\"\",0);\u003C\/script\u003E","vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":2910},{"function":"__html","metadata":["map"],"once_per_load":true,"vtp_html":"\u003Cscript data-gtmsrc=\"https:\/\/cnstrc.com\/js\/cust\/liverpool_d08Ft2.js\" type=\"text\/gtmscript\"\u003E\u003C\/script\u003E","vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":2985},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":"\u003Cscript type=\"application\/ld+json\"\u003E\n{\n  \"@context\": \"https:\/\/schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [{\n    \"@type\": \"Question\",\n    \"name\": \"¿Qué es el Buen Fin?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"¡El fin de semana más barato del año! A través de este evento impulsamos la economía y llevamos beneficios a las familias mexicanas. Durante este fin de semana ofrecemos los mejores precios y descuentos para que te lleves a casa todo lo que necesitas. En todos los departamentos podrás encontrar las ofertas y precios más bajos del año. Las promociones del Buen Fin son la oportunidad perfecta para adquirir bienes y artículos de todo tipo: electrónica, línea blanca, ropa de mujer, hombre y niños, juguetería, accesorios, joyería, muebles y todo lo que requieres para tu hogar.\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"¿Cuándo es el Buen Fin en Liverpool?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Puedes disfrutar de los mejores descuentos del 15 al 18 de noviembre del 2024. Para salvaguardar tu salud y tener la mejor experiencia de compra desde la comodidad de tu hogar, puedes adquirir tus artículos en línea o nuestra app Liverpool Pocket y disfrutar de los mismos beneficios que en tienda: garantía Liverpool y envío gratis en toda la República Mexicana. Con la garantía Liverpool no debes preocuparte porque alguno de tus artículos no cumpla tus expectativas: lo puedes regresar sin costo extra o penalizaciones. También ponemos a tu disposición Click \u0026 Collect para que compres en línea y recojas en tienda hasta en 2 horas ¡Hacer tus compras nunca fue tan fácil!\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"¿Cuáles serán las ofertas del Buen Fin?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Mantente al tanto de todas nuestras redes sociales y canales oficiales para conocer nuestras mejores ofertas. Los descuentos se comunican el día que inicia el Buen Fin pero seguro te sorprenderán las promociones en departamentos como electrónica, belleza, muebles, hogar, zapatos, deportes, videojuegos y más. Aprovecha nuestras promociones con las tarjetas Liverpool y demás tarjetas bancarias\"\n    }\n  },{\n    \"@type\": \"Question\",\n    \"name\": \"¿Cuáles son los horarios de las tiendas?\",\n    \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Puedes disfrutar de las ofertas del Buen Fin en el horario regular de nuestras tiendas: 11am a 9pm. No olvides que puedes descargar nuestra app Liverpool Pocket, donde encontrarás los mismos descuentos que en tienda mediante un simple click en tu celular. También puedes comprar desde la comodidad de tu hogar en liverpool.com.mx y obtener todos los beneficios que te ofrecemos en tiendas físicas, como envío gratis a cualquier lugar de la República Mexicana y garantía Liverpool.\"\n    }\n  }]\n}\n\u003C\/script\u003E\n","vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":3023},{"function":"__html","metadata":["map"],"once_per_event":true,"vtp_html":"\u003Cscript type=\"application\/ld+json\"\u003E\n    {\n        \"@context\": \"http:\/\/schema.org\/\",\n        \"@type\": \"SaleEvent\",\n        \"name\": \"Buen Fin  2024 Liverpool\",\n        \"description\": \"¡El fin de semana más barato del año! A través de este evento impulsamos la economía y llevamos beneficios a las familias mexicanas.\",\n        \"image\": \"https:\/\/assetspwa.liverpool.com.mx\/assets\/digital\/landing\/buenfin\/img\/blp_BF_bc_1024.jpg\",\n        \"eventAttendanceMode\": \"https:\/\/schema.org\/OnlineEventAttendanceMode\",\n        \"eventStatus\": \"https:\/\/schema.org\/EventScheduled\",\n        \"startDate\": \"2024-11-15T00:00:00.000-06:00\",\n        \"endDate\": \"2024-11-18T23:59:00.000-06:00\",\n        \"location\": [\n            {\n                \"@type\": \"VirtualLocation\",\n                \"url\": \"https:\/\/www.liverpool.com.mx\/tienda\/buen-fin\/catst44480398\"\n            }\n        ],\n        \"organizer\": {\n            \"@type\": \"Organization\",\n            \"name\": \"Liverpool\",\n            \"url\": \"https:\/\/www.liverpool.com.mx\/tienda\/buen-fin\/catst44480398\"\n        },\n        \"performer\": {\n            \"@type\": \"PerformingGroup\",\n            \"name\": \"Puerto de Liverpool\"\n        }\n    }\n\u003C\/script\u003E","vtp_supportDocumentWrite":false,"vtp_enableIframeMode":false,"vtp_enableEditJsMacroBehavior":false,"tag_id":3025},{"f