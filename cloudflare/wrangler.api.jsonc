// Portal Ventel en Cloudflare · Worker de API (producción).
//
// Es la mitad «servidor» (lo que en Apps Script era google.script.run): POST /api/rpc y /api/salud.
// No tiene dirección pública: solo lo llama el Worker del borde (wrangler.produccion.jsonc) por un
// Service Binding. Corre JUNTO A LA BASE D1 (placement), así cada consulta cuesta un par de ms.
//   npx wrangler deploy -c wrangler.api.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-ventel-api",
  "main": "src/worker/api.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "placement": { "region": "aws:us-west-1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ventel-portal",
      "database_id": "67945d75-23e1-45ac-957b-75942c336092",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVOS", "bucket_name": "ventel-portal-assets" }
  ],
  "vars": { "ENTORNO": "produccion" },
  "observability": { "enabled": true }
}
